# ---------------------------------------------------------------------------
# Impact Exteriors CRM — environment variables
#
# Copy to `.env` and fill in real values for local development. NEVER commit a
# populated `.env`. In production these should come from your host's secret
# manager (or Supabase Vault — see below).
# ---------------------------------------------------------------------------

# --- Google Workspace integration (Phase 1) -------------------------------
#
# Secrets are read server-side only via server/lib/secrets.ts. Two backends are
# supported, in priority order:
#
#   1. Supabase Vault (preferred for production). Set SUPABASE_URL +
#      SUPABASE_SERVICE_ROLE_KEY below and create Vault entries with the LOGICAL
#      names listed in docs/integrations/google-workspace.md. The env vars below
#      are then ignored.
#   2. Plain env vars (fallback / local dev). Set the GOOGLE_* vars below.
#
# Provide ONE backend. Do not mix.

# Service account JSON (the entire downloaded key file, single line). Used for
# Drive access via domain-wide delegation. Server-side only — never sent to the
# browser.
GOOGLE_SERVICE_ACCOUNT_JSON=

# The Workspace admin user the service account impersonates (domain-wide
# delegation subject). e.g. ops@yourdomain.com
GOOGLE_WORKSPACE_IMPERSONATION_EMAIL=

# Drive folder ID that all per-opportunity folders are created under.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Server-side API key for the Address Validation + Geocoding REST APIs.
# This is SEPARATE from the browser Maps key below and must be restricted to
# those two APIs.
GOOGLE_MAPS_API_KEY=

# Your Workspace primary domain (used in setup/docs; not required at runtime).
GOOGLE_WORKSPACE_DOMAIN=

# Browser-exposed Maps key. The CRM currently only builds Google Maps *links*
# (no Maps JS SDK), so this is optional. If you later embed a map, this key MUST
# be a separate, HTTP-referrer-restricted key — never reuse GOOGLE_MAPS_API_KEY.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# --- QuickBooks Online integration (Phase 2) ------------------------------
#
# Same Vault-or-env pattern as Phase 1 (server/lib/secrets.ts). In production
# prefer Supabase Vault with the LOGICAL secret names documented in
# docs/integrations/quickbooks.md; the QBO_* env vars below are the local-dev
# fallback. Provide ONE backend. NEVER commit real credentials.

# OAuth 2.0 app credentials from the Intuit developer dashboard (Keys & OAuth).
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=

# "sandbox" (Intuit sandbox company) or "production". Controls both the OAuth
# scope target and the REST base URL. Defaults to "production" if unset.
QBO_ENVIRONMENT=sandbox

# Must EXACTLY match a Redirect URI registered on the Intuit app, e.g.
# https://your-host/api/integrations/qbo/oauth/callback
QBO_REDIRECT_URI=

# Webhook verifier token from the Intuit app's Webhooks settings. Used to
# HMAC-SHA256 verify each incoming webhook BEFORE processing.
QBO_WEBHOOK_VERIFIER_TOKEN=

# 32-byte key used to AES-256-GCM encrypt OAuth tokens at rest. Accepts base64
# (44 chars), hex (64 chars), or any passphrase (hashed to 32 bytes). STRONGLY
# recommended in production. Generate: `openssl rand -base64 32`. If omitted,
# tokens are stored with a `plain:` marker (acceptable for local dev only).
QBO_TOKEN_ENCRYPTION_KEY=

# --- Supabase Vault (optional secrets backend) ----------------------------
# If set, secrets above are read from vault.decrypted_secrets via the service
# role instead of the GOOGLE_*/QBO_* env vars. Service-role key is server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
